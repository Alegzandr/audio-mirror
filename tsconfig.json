{
  // Type-checks the build-free UI; nothing is emitted, Tauri serves ui/ as is.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    // Each page script has its own scope, so app.js and splash.js may reuse names.
    "moduleDetection": "force"
  },
  "include": ["ui/*.js", "ui/types.d.ts"]
}
