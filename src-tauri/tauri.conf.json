{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Mirror",
  "mainBinaryName": "audio-mirror",
  "identifier": "io.github.alegzandr.audiomirror",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Audio Mirror",
        "width": 380,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "app"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Mirrors one audio source to several outputs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFNTBBOURGRTk4NjBERTcKUldUbkRZYnAzNmxRdnJZV1ZQTHZLRWRXem84eWdURU1pa1IzQVM2SmpQaTdTbFB3d1lGTzJ6b2MK",
      "endpoints": [
        "https://github.com/Alegzandr/audio-mirror/releases/latest/download/latest.json"
      ]
    }
  }
}
